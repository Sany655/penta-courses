# ==============================================================================
# Development Environment Variables Template
# ==============================================================================

# Application & Branding
APP_NAME="Unified Hybrid Adaptive Learning Platform"
BRAND_NAME="PentaCourse"
BRAND_DOMAIN="pentacourse.com"
APP_URL="http://localhost:3000"
SUPPORT_EMAIL="support@pentacourse.com"
DEFAULT_CURRENCY="USD"
ENVIRONMENT="development"

# Security & Tokens
SECRET_KEY="development-secret-key-adaptive-os-2026-super-secure"
JWT_SECRET="development-jwt-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Database (Development: SQLite or local PostgreSQL)
DATABASE_URL="sqlite:///./learning_os.db"
DB_POOL_SIZE="20"
DB_MAX_OVERFLOW="10"
DB_POOL_RECYCLE="300"

# CORS & Routing
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000"

# AI Provider (Server-Side Only)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""

# Stripe Payment Gateway (Sandbox / Test Mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# bKash Payment Gateway (Sandbox Mode)
BKASH_APP_KEY="bkash_sandbox_app_key"
BKASH_APP_SECRET="bkash_sandbox_app_secret"
BKASH_USERNAME="bkash_sandbox_user"
BKASH_PASSWORD="bkash_sandbox_pass"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Object Storage (S3 / Cloudflare R2)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_KEY=""
OBJECT_STORAGE_SECRET=""

# Monitoring & Analytics
ANALYTICS_ID=""
SENTRY_DSN=""
