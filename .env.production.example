# ==============================================================================
# Production Environment Variables Template
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Application & Branding
APP_NAME="Unified Hybrid Adaptive Learning Platform"
BRAND_NAME="Pentabrid"
BRAND_DOMAIN="pentabrid.com"
APP_URL="https://pentabrid.com"
SUPPORT_EMAIL="[EMAIL_ADDRESS]"
DEFAULT_CURRENCY="USD"
ENVIRONMENT="production"

# Security & Secrets (Generate strong 64-char random hex strings)
# e.g., openssl rand -hex 32
SECRET_KEY="asdfqwer"
JWT_SECRET="qwerasdf"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Database (PostgreSQL Managed Cluster - e.g., Supabase / Neon / AWS RDS / Railway)
DATABASE_URL="postgresql+psycopg2://app_user:STRONG_PASSWORD@db-host:5432/pentacourse_prod"
DB_POOL_SIZE="20"
DB_MAX_OVERFLOW="10"
DB_POOL_RECYCLE="300"

# CORS & Production Hostnames
FRONTEND_URL="https://pentacourse.com"
API_URL="https://api.pentacourse.com"
CORS_ORIGINS="https://pentacourse.com,https://www.pentacourse.com,https://app.pentacourse.com"

# AI Provider (Server-Side Only - Keep secure)
AI_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSy..."

# Stripe Payment Gateway (Live Mode)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# bKash Payment Gateway (Live Tokenized Checkout)
BKASH_APP_KEY="live_app_key_from_bkash_merchant_portal"
BKASH_APP_SECRET="live_app_secret_from_bkash_merchant_portal"
BKASH_USERNAME="live_merchant_username"
BKASH_PASSWORD="live_merchant_password"
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

# Object Storage (AWS S3 or Cloudflare R2)
OBJECT_STORAGE_BUCKET="pentacourse-production-assets"
OBJECT_STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
OBJECT_STORAGE_KEY="R2_ACCESS_KEY_ID"
OBJECT_STORAGE_SECRET="R2_SECRET_ACCESS_KEY"

# Observability, Error Tracking & Privacy Analytics
ANALYTICS_ID="PENTA-PROD-ANALYTICS-2026"
SENTRY_DSN="https://xxxx@sentry.io/yyyy"
